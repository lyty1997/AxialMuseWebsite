[Unit]
Description=Axial Muse weekly ledger backup
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/axialmuse-ledger-backup
TimeoutStartSec=300
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
UMask=0077
Nice=10
IOWeight=10
CPUQuota=25%
MemoryMax=192M
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/axialmuse/ledger-backup-maintenance /var/backups/axialmuse-ledger
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
