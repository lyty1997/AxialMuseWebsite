[Unit]
Description=Axial Muse local maintenance
After=local-fs.target nginx.service systemd-journald.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/axialmuse-local-maintenance
TimeoutStartSec=420
TimeoutStopSec=10
KillMode=control-group
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/axialmuse/maintenance /var/backups/axialmuse-ledger /var/lib/logrotate /var/log /run/log
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
