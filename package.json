{
  "name": "axial-muse-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "quality": "node scripts/quality/run-quality.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/quality/run-tests.mjs",
    "build": "node scripts/build/build-site.mjs --mode production",
    "package:artifact": "node scripts/release/package-site.mjs",
    "check:artifact": "node scripts/quality/check-release-package.mjs",
    "check:js": "node scripts/quality/check-javascript.mjs",
    "check:module-boundaries": "node scripts/quality/check-module-boundaries.mjs",
    "check:npm-isolation": "node scripts/quality/check-npm-isolation.mjs",
    "check:docs": "node scripts/quality/check-markdown.mjs",
    "check:contracts": "node scripts/quality/check-contracts.mjs",
    "check:secrets": "node scripts/quality/check-secrets.mjs",
    "check:supply-chain": "node scripts/quality/check-supply-chain.mjs",
    "check:site": "node scripts/quality/check-static-site.mjs",
    "check:diagrams": "node scripts/quality/check-diagrams.mjs",
    "gen:diagrams": "node scripts/quality/render-diagrams.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "overrides": {
    "serialize-javascript": "7.0.5",
    "uuid": "11.1.1"
  }
}
