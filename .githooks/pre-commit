#!/usr/bin/env bash
# 本地提交前门禁：通过 E-010 隔离入口运行统一质量负载。
# 启用方式（仓库首次克隆后执行一次）：git config core.hooksPath .githooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: 未找到 Node，无法运行质量门禁。" >&2
  exit 1
fi

echo "pre-commit: 运行隔离质量入口 ..."
node scripts/quality/run-isolated-npm.mjs run-script quality
